# Copy to .env.local and fill in. Never commit .env.local.
# In production these are configured in the Vercel project settings instead.

# Supabase project URL and anon key. Both are exposed to the browser by design;
# the anon key is safe to publish because Row Level Security governs what it can read.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. Bypasses Row Level Security entirely.
# Server-side only, never prefixed with NEXT_PUBLIC_, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider key for the attendance agent. Added to the validated env schema in Phase 5.
AI_PROVIDER_API_KEY=
